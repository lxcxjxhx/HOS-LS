# === HOS-LS .gitignore ===

# Python build and cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Testing and coverage
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.trae/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
*.pem
*.key

# Logs
*.log

# Database files
nvd_vulnerability.db
*.db

# RAG knowledge base cache
embeddings_cache/
rag_knowledge_base/history/

# Vulnerability scan data (only first level subfolders)
"All Vulnerabilities/*/*"
All Vulnerabilities/

# Misc cache
.cache/

# Local benchmark run artifacts (see bench/benchmark.py outputs)
hosls-eval/
bench/artifacts/
bench-tmp/

# RULEDROID 自动生成的 semgrep 规则（scripts/gen_semgrep_rules.py 可再生成）
envs/semgrep-rules/auto/

# HOS-LS indexes
.hos-ls/indexes/

# CodeGraph pre-index (token-saving code intelligence)
.codegraph/

# External toolchain & rule sets (rebuild via envs/scripts, not versioned)
envs/codeql/
envs/codeql-packs/
envs/semgrep-rules/
envs/sast-venv/

# Benchmark data — cloned repos and evaluation frameworks too large for versioning
bench/datasets/repos/
bench/datasets/SecureVibeBench/evaluation/
bench/datasets/VulnGym/data/*.jsonl
!bench/datasets/VulnGym/data/*.md

# Experiment intermediate files
bench/experiments/ai_patches/

# Temp scripts
_summary.py
